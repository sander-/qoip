@page
@model Qoip.Web.Pages.EmailSecurityAnalysisModel
@{
    ViewData["Title"] = "Email Security Analysis";
}

<section class="container mt-5">
    <h3 class="mb-4">Email Security Analysis</h3>

    <div id="app">
        <form v-on:submit.prevent="performRequest" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="domain" class="form-label">Domain:</label>
                <input type="text" id="domain" v-model="domain" class="form-control" required>
                <div class="invalid-feedback">
                    Please enter a domain.
                </div>
            </div>
            <div class="mb-3">
                <label for="dkimSelector" class="form-label">DKIM Selector:</label>
                <input type="text" id="dkimSelector" v-model="dkimSelector" class="form-control" required>
            </div>
            <div class="mb-3">
                <label for="dnsServer" class="form-label">DNS Server (optional):</label>
                <input type="text" id="dnsServer" v-model="dnsServer" class="form-control">
            </div>
            <div class="mb-3">
                <label for="timeout" class="form-label">Timeout (ms):</label>
                <input type="number" id="timeout" v-model="timeout" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-primary" :disabled="loading">Submit</button>
            <button type="button" class="btn btn-secondary ms-2" v-on:click="clearForm">Clear</button>
        </form>
        <div v-if="loading" class="mt-3">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
        <div v-if="response" class="mt-4">
            <h2 class="h5">Email Security Analysis Response</h2>
            <pre class="bg-dark p-3 border rounded">{{ response }}</pre>
        </div>
        <div v-if="error" class="mt-4 alert alert-danger">
            {{ error }}
        </div>
    </div>
</section>

@section Scripts {
    <script type="module" src="~/js/emailsecurityanalysis.js" asp-append-version="true"></script>
}
