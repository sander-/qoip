@page
@model Qoip.Web.Pages.RangeScanModel
@{
    ViewData["Title"] = "Range Scan";
}

<section class="container mt-5">
    <h3 class="mb-4">Range Scan</h3>

    <div id="app">
        <form v-on:submit.prevent="performRequest" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="range" class="form-label">Range:</label>
                <input type="text" id="range" v-model="range" class="form-control" placeholder="192.168.1.0/24 or 192.168.1.1-192.168.1.10" required>
                <div class="invalid-feedback">
                    Please enter a valid range.
                </div>
            </div>
            <div class="mb-3">
                <label for="portSet" class="form-label">Port Set:</label>
                <select id="portSet" v-model="portSet" class="form-select">
                    <option value="minimal">minimal</option>
                    <option value="common">common</option>
                    <option value="all">all</option>
                </select>
            </div>
            <div class="mb-3">
                <label for="timeout" class="form-label">Timeout (ms):</label>
                <input type="number" id="timeout" v-model="timeout" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-primary" :disabled="loading">Submit</button>
            <button type="button" class="btn btn-secondary ms-2" v-on:click="clearForm">Clear</button>
        </form>
        <div v-if="loading" class="mt-3">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
        <div v-if="response" class="mt-4">
            <h2 class="h5">Range Scan Response</h2>
            <pre class="bg-dark p-3 border rounded">{{ response }}</pre>
        </div>
        <div v-if="error" class="mt-4 alert alert-danger">
            {{ error }}
        </div>
    </div>
</section>

@section Scripts {
    <script type="module" src="~/js/rangescan.js" asp-append-version="true"></script>
}
