{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "wwwroot/ts",
    "outDir": "wwwroot/js"
  },
  "include": [ "wwwroot/ts/**/*" ],
  "exclude": [ "wwwroot/js/**/*" ]
}
